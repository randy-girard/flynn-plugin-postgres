{
  "name": "postgres",
  "kind": "resource-provider",
  "tenant_safe": true,
  "github_repo": "randy-girard/flynn-plugin-postgres",
  "provider": {
    "name": "postgres",
    "url": "http://postgres-plugin.discoverd/databases"
  },
  "app": {
    "name": "postgres-plugin",
    "meta": {
      "flynn-system-app": "true",
      "flynn-plugin": "true",
      "flynn-datastore": "true",
      "flynn-expose-port": "5432",
      "flynn-expose-tls": "required"
    },
    "processes": {
      "web": {
        "args": [
          "/bin/start-flynn-postgres",
          "api"
        ],
        "ports": [
          {
            "port": 80,
            "proto": "tcp",
            "service": {
              "name": "postgres-plugin",
              "create": true,
              "check": {
                "type": "http",
                "path": "/ping"
              }
            }
          }
        ]
      }
    }
  },
  "inject_env": [
    "CONTROLLER_KEY",
    "DISCOVERD_AUTH_KEY",
    "SINGLETON",
    "CLUSTER_DOMAIN"
  ],
	"image_env": {
    "POSTGRES_IMAGE_ID": "self",
    "ENGINE_VERSION": "16"
  },
  "env": {
    "POSTGRES_TLS_ENABLED": "true"
  },
  "expose": {
    "port": 5432,
    "proto": "tcp",
    "tls": true,
    "leader": true,
    "service_env": "FLYNN_POSTGRES"
  },
  "dashboard": {
    "base_url": "http://postgres-plugin.discoverd/dashboard",
    "surfaces": [
      "app.resources"
    ],
    "card": {
      "title": "Postgres",
      "description": "One isolated Postgres instance per resource",
      "icon": "postgres"
    },
    "routes": [
      {
        "path": "/",
        "title": "Overview"
      },
      {
        "path": "/databases",
        "title": "Databases"
      },
      {
        "path": "/users",
        "title": "Users"
      },
      {
        "path": "/backup",
        "title": "Backup"
      },
      {
        "path": "/replication",
        "title": "Followers"
      },
      {
        "path": "/settings",
        "title": "Settings"
      }
    ]
  },
  "cli": {
    "command": "pg",
    "usage": "manage an isolated postgres instance",
    "subcommands": [
      "list",
      "info",
      "create",
      "follow",
      "wait",
      "promote",
      "unfollow",
      "upgrade",
      "dump",
      "restore",
      "psql",
      "help"
    ],
	"doc": "usage: flynn pg\n       flynn pg info\n       flynn pg:list\n       flynn pg:help\n       flynn pg create <database>\n       flynn pg follow [--runtime <name>]\n       flynn pg wait <resource>\n       flynn pg promote <follower>\n       flynn pg unfollow <follower>\n       flynn pg upgrade\n       flynn pg dump [-q] [-f <file>]\n       flynn pg restore [-q] [-f <file>]\n       flynn pg psql [--] [<argument>...]\n\nEach resource is its own Postgres instance (one app, one volume, one node).\nflynn pg create adds a logical database on that server (CREATE DATABASE),\nnot a new Flynn resource. Followers are separate resources and always use\nstreaming replication on the same engine version. There is no in-place resize\nor upgrade: pg:upgrade uses logical replication, promotes a new primary, then\nrecreates each follower against that primary.\n\nOptions:\n\t-f, --file=<file>  dump file (stdout/stdin if omitted)\n\t-q, --quiet        don't print progress\n\t--runtime=<name>   database runtime for a new follower (default: same as primary)\n\nCommands:\n\tlist       Same as flynn pg with no subcommand\n\thelp       Same as flynn pg --help\n\tinfo       Show leader, followers, and lag\n\tcreate     CREATE DATABASE on this instance\n\tfollow     Create a streaming read-only follower (same engine version). flynn pg follow pg-<word>-<6 letters> follows that primary.\n\twait       Block until the follower lag is zero\n\tpromote    Make a follower writable and rewrite the primary *_URL\n\tunfollow   Stop replication and leave a standalone writable copy\n\tupgrade    Logical follow, wait, promote, then recreate followers\n\tdump       pg_dump this instance (custom format)\n\trestore    Restore a dump taken with pg dump\n\tpsql       Open psql. With one attached database, a name is optional. With a primary and a follower, pass the instance (pg-<word>-<6 letters>). Works on apps that have a resource but no git release.\n",
    "resource_env": "FLYNN_POSTGRES",
    "resource_missing": "No postgres database found. Provision one with `flynn resource:add postgres`",
    "actions": [
      {
        "name": "create",
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "create-db",
          "${resource}"
        ],
        "append": "<database>"
      },
      {
        "name": "info",
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "info",
          "${resource}"
        ]
      },
      {
        "name": "follow",
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "follow",
          "${resource}",
          "${app}"
        ]
      },
      {
        "name": "wait",
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "wait",
          "${resource}"
        ]
      },
      {
        "name": "promote",
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "promote",
          "${resource}"
        ]
      },
      {
        "name": "unfollow",
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "unfollow",
          "${resource}"
        ]
      },
      {
        "name": "upgrade",
        "cluster": true,
        "args": [
          "/bin/flynn-postgres-api",
          "task",
          "upgrade",
          "${resource}"
        ]
      },
      {
        "name": "dump",
        "args": [
          "pg_dump",
          "--no-owner",
          "--format=custom",
          "${app.POSTGRES_URL}"
        ],
        "stdout_file": "--file",
        "progress": true,
        "quiet": "--quiet"
      },
      {
        "name": "restore",
        "args": [
          "pg_restore",
          "--no-owner",
          "--clean",
          "--if-exists",
          "--dbname",
          "${app.POSTGRES_URL}"
        ],
        "stdin_file": "--file",
        "progress": true,
        "quiet": "--quiet"
      },
      {
        "name": "psql",
        "args": [
          "psql",
          "${app.POSTGRES_URL}"
        ],
        "append": "<argument>",
        "env": {
          "PAGER": "less",
          "LESS": "--ignore-case --LONG-PROMPT --SILENT --tabs=4 --quit-if-one-screen --no-init --quit-at-eof"
        }
      }
    ]
  },
  "hooks": {
    "install": "script/install.sh",
    "upgrade": "script/install.sh",
    "uninstall": "script/uninstall.sh"
  },
  "build": {
    "base": {
      "repo": "randy-girard/flynn",
      "version": "latest",
      "image": "ubuntu-noble"
    },
    "entrypoint": [
      "/bin/start-flynn-postgres"
    ],
    "packages": "img/packages.sh",
    "go": {
      "./cmd/flynn-postgres": "/bin/flynn-postgres",
      "./cmd/flynn-postgres-api": "/bin/flynn-postgres-api"
    },
    "copy": {
      "start.sh": "/bin/start-flynn-postgres"
    }
  },
  "artifacts": {
    "image": ""
  }
}
